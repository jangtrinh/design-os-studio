## mutant 2: patch
diff --git a/crates/designos-render/src/vectorops.rs b/crates/designos-render/src/vectorops.rs
index f2ab8a68f..0877298a0 100644
--- a/crates/designos-render/src/vectorops.rs
+++ b/crates/designos-render/src/vectorops.rs
@@ -866,6 +866,9 @@ fn cap_polygons(sub: &d::Path, w: f32, join: d::StrokeJoin, start_cap: d::Stroke
 /// through) whose cap is not the cap of the dashes. A dashed stroke caps every dash with `Stroke::cap`; the cap of an
 /// end point shows only where the first dash starts or the last dash ends.
 fn dashed_end_caps(stroke: &d::Stroke, net: &VectorNetwork) -> bool {
+    if stroke.weight >= 0.0 {
+        return false;
+    }
     stroke.weight > 0.0
         && crate::outline::has_dashes(stroke)
         && net.vertices.iter().any(|v| v.cap.is_some_and(|c| c != stroke.cap))

