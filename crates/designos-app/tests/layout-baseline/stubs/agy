#!/bin/sh
if [ "$1" = "--version" ]; then
    echo "agy 1.0.0-stub"
    exit 0
fi
if [ "$1" = "auth" ] && [ "$2" = "status" ]; then
    echo '{"loggedIn":true}'
    exit 0
fi
if [ "$1" = "login" ] && [ "$2" = "status" ]; then
    echo "Logged in"
    exit 0
fi
for arg in "$@"; do
    if [ "$arg" = "--mcp-config" ]; then
        if [ -n "$DESIGNOS_STUB_LOG" ]; then
            printf '%s %s\n' "$0" "$*" >> "$DESIGNOS_STUB_LOG"
        fi
        echo "flags provided but not defined: -mcp-config" >&2
        exit 1
    fi
done
if [ -n "$DESIGNOS_STUB_LOG" ]; then
    printf '%s %s\n' "$0" "$*" >> "$DESIGNOS_STUB_LOG"
fi
exec /bin/cat
