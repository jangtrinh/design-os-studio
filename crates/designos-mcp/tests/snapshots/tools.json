    "description": "Render a node, a set of nodes on the same page, or a page-space rectangular region and return it inline as MCP image content (PNG or JPEG), automatically downsized to max_long_edge (default 1024).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "default": "png",
          "enum": [
            "png",
            "jpeg"
          ]
        },
        "max_long_edge": {
          "default": 1024,
          "maximum": 4096,
          "minimum": 0,
          "type": "integer"
        },
        "node_id": {
          "minimum": 1,
          "type": "integer"
        },
        "node_ids": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        },
        "quality": {
          "default": 80,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "region": {
          "additionalProperties": false,
          "properties": {
            "height": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "page_id": {
              "minimum": 1,
              "type": "integer"
            },
            "width": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "height",
            "page_id",
            "width",
            "x",
            "y"
          ],
          "type": "object"
        },
        "scale": {
          "default": 0.5,
          "maximum": 4,
          "minimum": 0.25,
          "type": "number"
        }
      },
      "required": [],
      "type": "object"
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "designos_apply_batch",
    "description": "Execute 1..=200 write operations (apply_spec, insert, update, move, delete, set_variables, set_style) as a single atomic transaction and one undo group. Later ops may reference nodes created by earlier ops via '@<as>' or '@<as>/<name path>'. With dry_run=true, computes and returns created IDs, name_to_id map, touched_roots, and touched_bounds without mutating the document or publishing a live patch. Note: in a live Studio session, if the editor remaps a colliding ID on replay, the reply holds the session IDs until the next canvas reload.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "diff_image": {
          "default": false,
          "type": "boolean"
        },
        "dry_run": {
          "default": false,
          "type": "boolean"
        },
        "idempotency_key": {
          "maxLength": 128,
          "type": "string"
        },
        "ops": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "apply": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "as": {
                "pattern": "^[A-Za-z0-9_-]{1,64}$",
                "type": "string"
              },
              "delete": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "delete_variables": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "fill": {
                "maxLength": 1024,
                "type": "string"
              },
              "fills": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "height": {
                "maximum": 1000000,
                "minimum": 0,
                "type": "number"
              },
              "index": {
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "frame",
                  "rectangle",
                  "ellipse",
                  "text"
                ],
                "type": "string"
              },
              "name": {
                "maxLength": 1024,
                "type": "string"
              },
              "node": {
                "anyOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "pattern": "^@[A-Za-z0-9_-]{1,64}(/.+)?$",
                    "type": "string"
                  }
                ],
                "description": "Numeric node ID or '@<as>' / '@<as>/<name path>' reference to an earlier op in the same batch."
              },
              "node_id": {
                "anyOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "pattern": "^@[A-Za-z0-9_-]{1,64}(/.+)?$",
                    "type": "string"
                  }
                ],
                "description": "Numeric node ID or '@<as>' / '@<as>/<name path>' reference to an earlier op in the same batch."
              },
              "op": {
                "enum": [
                  "apply_spec",
                  "insert",
                  "update",
                  "move",
                  "delete",
                  "set_variables",
                  "set_style"
                ],
                "type": "string"
              },
              "opacity": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "parent": {
                "anyOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "pattern": "^@[A-Za-z0-9_-]{1,64}(/.+)?$",
                    "type": "string"
                  }
                ],
                "description": "Numeric node ID or '@<as>' / '@<as>/<name path>' reference to an earlier op in the same batch."
              },
              "parent_id": {
                "anyOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "pattern": "^@[A-Za-z0-9_-]{1,64}(/.+)?$",
                    "type": "string"
                  }
                ],
                "description": "Numeric node ID or '@<as>' / '@<as>/<name path>' reference to an earlier op in the same batch."
              },
              "spec": {
                "type": "object"
              },
              "text": {
                "maxLength": 100000,
                "type": "string"
              },
              "upsert": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "upsert_collections": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "upsert_variables": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "visible": {
                "type": "boolean"
              },
              "width": {
                "maximum": 1000000,
                "minimum": 0,
                "type": "number"
              },
              "x": {
                "maximum": 1000000,
                "minimum": -1000000,
                "type": "number"
              },
              "y": {
                "maximum": 1000000,
                "minimum": -1000000,
                "type": "number"
              }
            },
            "required": [
              "op"
            ],
            "type": "object"
          },
          "maxItems": 200,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "ops"
      ],
      "type": "object"
    },
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    }
  },
  {
    "name": "designos_get_design_context",
    "description": "Return generated code in the target language, Dev Mode hints (variables with CSS/platform code syntax, linked styles, component instances/properties, annotations, dev status, Code Connect stub), and an inline screenshot (scale 0.5, max_long_edge 1024), with an XML outline fallback when the subtree exceeds 5,000 nodes or generated code exceeds 40,000 characters.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "include_screenshot": {
          "default": true,
          "type": "boolean"
        },
        "language": {
          "default": "css",
          "type": "string"
        },
        "node_id": {
          "minimum": 1,
          "type": "integer"
        },
        "react_tailwind": {
          "default": false,
          "type": "boolean"
        },
        "response_format": {
          "default": "concise",
          "enum": [
            "concise",
            "detailed"
          ]
        }
      },
      "required": [
        "node_id"
      ],
      "type": "object"
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "designos_open_file",
    "description": "Import a .designos, .designos, .fig, SVG or Figma REST JSON file inside the workspace into this isolated session. Does not control an open editor. Unsaved changes require discard_changes=true.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "discard_changes": {
          "default": false,
          "type": "boolean"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    }
  },
  {
    "name": "designos_save_file",
    "description": "Save this session to a .designos file inside the workspace. Existing files are not overwritten unless overwrite=true. Parent directory must exist.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "overwrite": {
          "default": false,
          "type": "boolean"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    }
  },
  {
    "name": "designos_render_png",
    "description": "Rasterize a frame or layer to a NEW .png file inside the workspace using DESIGN:OS Studio's deterministic renderer. Existing files are never overwritten.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "scale": {
          "default": 1.0,
          "maximum": 4.0,
          "minimum": 0.25,
          "type": "number"
        }
      },
      "required": [
        "node_id",
        "path"
      ],
      "type": "object"
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    }
  },
  {
    "name": "designos_new_document",
    "description": "Start a blank document with one page. Unsaved changes require discard_changes=true.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "discard_changes": {
          "default": false,
          "type": "boolean"
        },
        "name": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    }
  }
]
