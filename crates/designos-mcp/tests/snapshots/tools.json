  {
    "name": "designos_apply_batch",
    "description": "Execute 1..=200 write operations (apply_spec, insert/create, update, move, delete, set_slot, set_variables, set_style) as a single atomic transaction and one undo group. Later ops may reference nodes created by earlier ops via '$prev', '@<as>', or '@<as>/<name path>'. With dry_run=true, computes and returns created IDs, name_to_id map, touched_roots, and touched_bounds without mutating the document or publishing a live patch. Note: in a live Studio session, if the editor remaps a colliding ID on replay, the reply holds the session IDs until the next canvas reload. Examples: (1) create + $prev: {\"ops\":[{\"op\":\"create\",\"parent\":1,\"kind\":\"frame\",\"name\":\"Header\"},{\"op\":\"create\",\"parent\":\"$prev\",\"kind\":\"text\",\"text\":\"Title\"}]}; (2) apply_spec with as + @handle/Child update: {\"ops\":[{\"op\":\"apply_spec\",\"as\":\"hero\",\"spec\":{\"kind\":\"frame\",\"name\":\"Hero\",\"children\":[{\"kind\":\"text\",\"name\":\"Child\",\"text\":\"Hi\"}]}},{\"op\":\"update\",\"node\":\"@hero/Child\",\"opacity\":0.9}]}; (3) set_slot: {\"ops\":[{\"op\":\"set_slot\",\"node\":\"@card\",\"slot\":\"body\",\"fill\":[{\"kind\":\"text\",\"text\":\"Body\"}]}]}; (4) dry_run: {\"dry_run\":true,\"ops\":[{\"op\":\"insert\",\"kind\":\"rectangle\",\"name\":\"Box\"}]}.",
    "inputSchema": {
      "additionalProperties": false,
      "examples": [
        {
          "ops": [
            {
              "height": 64,
              "kind": "frame",
              "name": "Header",
              "op": "create",
              "parent": 1,
              "width": 320
            },
            {
              "kind": "text",
              "name": "Title",
              "op": "create",
              "parent": "$prev",
              "text": "Dashboard"
            }
          ]
        },
        {
          "ops": [
            {
              "as": "hero",
              "op": "apply_spec",
              "parent": 1,
              "spec": {
                "children": [
                  {
                    "kind": "text",
                    "name": "Child",
                    "text": "Welcome"
                  }
                ],
                "kind": "frame",
                "name": "Hero"
              }
            },
            {
              "node": "@hero/Child",
              "op": "update",
              "opacity": 0.9
            }
          ]
        },
        {
          "ops": [
            {
              "as": "card",
              "op": "apply_spec",
              "parent": 1,
              "spec": {
                "component": "Card",
                "kind": "instance"
              }
            },
            {
              "fill": [
                {
                  "kind": "text",
                  "name": "BodyText",
                  "text": "Filled slot"
                }
              ],
              "node": "@card",
              "op": "set_slot",
              "slot": "body"
            }
          ]
        },
        {
          "dry_run": true,
          "ops": [
            {
              "as": "preview",
              "height": 80,
              "kind": "rectangle",
              "name": "PreviewBox",
              "op": "insert",
              "parent": 1,
              "width": 160
            }
          ]
        }
      ],
      "properties": {
        "diff_image": {
          "default": false,
          "type": "boolean"
        },
        "dry_run": {
          "default": false,
          "type": "boolean"
        },
        "idempotency_key": {
          "maxLength": 128,
          "type": "string"
        },
        "lint": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "preset",
                "errors_only",
                "off"
              ],
              "type": "string"
            }
          ],
          "description": "Optional per-call lint override (false or 'off' skips the per-call lint pass)."
        },
        "ops": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "apply": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "as": {
                "pattern": "^[A-Za-z0-9_-]{1,64}$",
                "type": "string"
              },
              "delete": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "delete_variables": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "fill": {
                "maxLength": 1024
              },
              "fills": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "height": {
                "maximum": 1000000,
                "minimum": 0,
                "type": "number"
              },
              "index": {
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "frame",
                  "rectangle",
                  "ellipse",
                  "text"
                ],
                "type": "string"
              },
              "name": {
                "maxLength": 1024,
                "type": "string"
              },
              "node": {
                "anyOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "pattern": "^(@[A-Za-z0-9_-]{1,64}|\\$prev)(/.+)?$",
                    "type": "string"
                  }
                ],
                "description": "Numeric node ID, '$prev', or '@<as>' / '@<as>/<name path>' reference to an earlier op in the same batch."
              },
              "node_id": {
                "anyOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "pattern": "^(@[A-Za-z0-9_-]{1,64}|\\$prev)(/.+)?$",
                    "type": "string"
                  }
                ],
                "description": "Numeric node ID, '$prev', or '@<as>' / '@<as>/<name path>' reference to an earlier op in the same batch."
              },
              "op": {
                "enum": [
                  "apply_spec",
                  "insert",
                  "create",
                  "update",
                  "move",
                  "delete",
                  "set_slot",
                  "set_variables",
                  "set_style"
                ],
                "type": "string"
              },
              "opacity": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "parent": {
                "anyOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "pattern": "^(@[A-Za-z0-9_-]{1,64}|\\$prev)(/.+)?$",
                    "type": "string"
                  }
                ],
                "description": "Numeric node ID, '$prev', or '@<as>' / '@<as>/<name path>' reference to an earlier op in the same batch."
              },
              "parent_id": {
                "anyOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "pattern": "^(@[A-Za-z0-9_-]{1,64}|\\$prev)(/.+)?$",
                    "type": "string"
                  }
                ],
                "description": "Numeric node ID, '$prev', or '@<as>' / '@<as>/<name path>' reference to an earlier op in the same batch."
              },
              "slot": {
                "type": "string"
              },
              "slots": {
                "type": "object"
              },
              "spec": {
                "type": "object"
              },
              "text": {
                "maxLength": 100000,
                "type": "string"
              },
              "upsert": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "upsert_collections": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "upsert_variables": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "visible": {
                "type": "boolean"
              },
              "width": {
                "maximum": 1000000,
                "minimum": 0,
                "type": "number"
              },
              "x": {
                "maximum": 1000000,
                "minimum": -1000000,
                "type": "number"
              },
              "y": {
                "maximum": 1000000,
                "minimum": -1000000,
                "type": "number"
              }
            },
            "required": [
              "op"
            ],
            "type": "object"
          },
          "maxItems": 200,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "ops"
      ],
      "type": "object"
    },
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    }
  },
