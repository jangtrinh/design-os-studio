          "enum": [
            "frame",
            "rectangle",
            "ellipse",
            "text"
          ],
          "type": "string"
        },
        "lint": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "preset",
                "errors_only",
                "off"
              ],
              "type": "string"
            }
          ],
          "description": "Optional per-call lint override (false or 'off' skips the per-call lint pass)."
        },
        "name": {
          "description": "Layer name; limited to 1024 UTF-8 bytes.",
          "maxLength": 1024,
          "type": "string"
        },
        "parent_id": {
          "description": "DesignOS numeric node ID; obtain from list_nodes/get_document.",
          "minimum": 1,
          "type": "integer"
        },
        "text": {
          "description": "Plain text; limited to 100000 UTF-8 bytes.",
          "maxLength": 100000,
          "type": "string"
        },
        "width": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "number"
        },
        "x": {
          "maximum": 1000000,
          "minimum": -1000000,
          "type": "number"
        },
        "y": {
          "maximum": 1000000,
          "minimum": -1000000,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "parent_id"
      ],
      "type": "object"
    },
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    }
