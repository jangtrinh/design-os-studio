  {
    "name": "designos_create_node",
    "description": "Create one layer in a container; defaults to x/y=0, width/height=100. Supports undo. Text is only valid for text layers. Changes are in memory until saved. Content added to, removed from or moved in an instance slot is kept when the main component changes.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "diff_image": {
          "default": false,
          "type": "boolean"
        },
        "fill": {
          "maxLength": 1024,
          "type": "string"
        },
        "fills": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "height": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "number"
